# 后端环境变量模板（复制为 server/.env 并填值；真实 .env 已被 git 忽略）

# 服务
PORT=3001

# 数据库（Phase 2 起启用，只连 127.0.0.1）
DATABASE_URL=postgresql://qiyu:CHANGE_ME@127.0.0.1:5432/qiyu

# 认证
JWT_SECRET=CHANGE_ME_RANDOM_LONG_STRING

# AI
DEEPSEEK_API_KEY=

# 讯飞（ASR/TTS）
IFLYTEK_APPID=
IFLYTEK_APIKEY=
IFLYTEK_APISECRET=
XFYUN_SUPERNATURAL_URL=
XFYUN_TTS_ENGINE=standard
TTS_ENGINE=iflytek

# Operit（内网 TTS，可选）
OPERIT_HOST=
OPERIT_PORT=
OPERIT_TOKEN=
OPERIT_API_URL=

# 短信（Spug）
SMS_MODE=mock
SMS_API_URL=
SMS_API_TOKEN=
SMS_TEMPLATE_ID=

# 邮件（QQ SMTP）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
